{
  "$schema": "vscode://schemas/color-theme",
  "name": "chromaticli light-yellow",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#413911",
    "descriptionForeground": "#675f3e",
    "disabledForeground": "#7d7656",
    "focusBorder": "#7e6700",
    "errorForeground": "#66591b",
