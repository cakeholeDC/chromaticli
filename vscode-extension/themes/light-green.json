{
  "$schema": "vscode://schemas/color-theme",
  "name": "chromaticli light-green",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#114215",
    "descriptionForeground": "#3f6942",
    "disabledForeground": "#577f5a",
    "focusBorder": "#287b2e",
    "errorForeground": "#1b6720",
