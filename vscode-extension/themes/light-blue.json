{
  "$schema": "vscode://schemas/color-theme",
  "name": "chromaticli light-blue",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#183b5b",
    "descriptionForeground": "#486278",
    "disabledForeground": "#61788d",
    "focusBorder": "#1f6096",
    "errorForeground": "#a42b40",
